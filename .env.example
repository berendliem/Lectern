DATABASE_URL="file:./prisma/dev.db"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL_SUMMARY="openrouter/free"
OPENROUTER_MODEL_FLASHCARDS="openrouter/free"
OPENROUTER_MODEL_QUIZ="openrouter/free"
OPENROUTER_MODEL_CHAT="openrouter/free"
# Optional — the Feynman coach falls back to CHAT then SUMMARY if unset.
OPENROUTER_MODEL_FEYNMAN="openrouter/free"

# Reading photographed pages of handwritten notes. Free, but named rather than
# left to openrouter/free: the router can pick a text-only model, which then
# answers from the prompt alone and invents a page it never saw. Whatever you
# put here must accept images. Other free options with vision today:
# google/gemma-4-26b-a4b-it:free, thinkingmachines/inkling:free.
OPENROUTER_MODEL_VISION="google/gemma-4-31b-it:free"

# Scanning is the one step worth running locally even if everything else is on
# OpenRouter: no rate limit, no per-page cost, and the photo never leaves the
# machine. Set this to "ollama" and pull a multimodal model.
# LLM_PROVIDER_VISION="ollama"
# The model that step uses on the local path. A text-only model ignores the
# image silently and makes the page up. Run: ollama pull qwen2.5vl
OLLAMA_MODEL_VISION="qwen2.5vl:7b"

WHISPER_SERVICE_URL="http://127.0.0.1:8000"

# Transcription provider: "whisper" (default, the Python service above, runs
# everywhere) or "apple" (on-device, macOS 26+ only: Apple's Speech framework
# for the text and FluidAudio for speaker labels). The apple provider needs the
# mac-speech binary, which `npm run setup` builds only when this says apple.
# Anything it can't do — no binary, no model, no ffmpeg for a webm recording —
# falls back to whisper silently, so a wrong value costs speed, not a transcript.
TRANSCRIBE_PROVIDER="whisper"
# Locale for the on-device speech model, as BCP-47. Defaults to en-US. A locale
# the OS ships no model for fails the apple path, which then falls back.
# TRANSCRIBE_LOCALE="en-US"
# Path to a mac-speech binary installed outside the repo.
# MAC_SPEECH_BIN=""

# LLM provider: "openrouter" (default, cloud) or "ollama" (fully local).
# LLM_PROVIDER sets the default for every AI step; LLM_PROVIDER_SUMMARY
# optionally overrides just summarization/action-items — e.g. keep chat on
# OpenRouter but summarize locally with Qwen3:
#   LLM_PROVIDER_SUMMARY="ollama"
LLM_PROVIDER="openrouter"
# LLM_PROVIDER_SUMMARY="ollama"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"

# MCP integrations (optional) — servers are configured in mcp.config.json
# (copy mcp.config.example.json). Notion sync creates pages under this parent
# page id (share the page with your Notion integration first):
# NOTION_PARENT_PAGE_ID=""
# Local hour (0-23) for "Add review sessions to calendar" events:
# REVIEW_EVENT_HOUR="18"

# OCR language for scanned PDF pages, as Tesseract language codes. Combine
# several with "+" (e.g. "eng+nld"); each one is a separate ~10MB download from
# cdn.jsdelivr.net that the browser caches on first use. Getting this wrong
# doesn't fail loudly — it silently returns garbled text.
NEXT_PUBLIC_OCR_LANG="eng"

# Embeddings for course-scoped semantic search.
# "local" runs Xenova/all-MiniLM-L6-v2 in this process — free, offline, no key.
# "openrouter" uses OPENROUTER_MODEL_EMBED instead. Switching provider or model
# invalidates every stored vector: run `npm run reindex` afterwards.
EMBED_PROVIDER="local"
OPENROUTER_MODEL_EMBED="openai/text-embedding-3-small"

# Reasoning tier: course-scoped work that needs a longer prompt and better
# reasoning (course ask today; syllabus parsing and coverage matching later).
# Dispatched by LLM_PROVIDER like every other call. Free on both paths.
OPENROUTER_MODEL_REASONING="openrouter/free"
OLLAMA_MODEL_REASONING="qwen3:8b"

# Syllabus coverage: minimum cosine similarity between a syllabus topic and a
# chunk of this course's content before the topic counts as covered. A topic
# title is short and a chunk is long, so scores run lower than you'd expect;
# raise this if unrelated lectures are being credited, lower it if lectures
# that clearly teach a topic are not.
COVERAGE_THRESHOLD="0.5"
